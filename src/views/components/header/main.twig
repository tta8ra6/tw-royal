<div class="header-top">
    <div class="container">
        <div class="header-top-inner">
            <div class="header-contact">
                <span class="contact-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
                    {{ store.phone }}
                </span>
            </div>
            <div class="header-social">
                {% if store.social.facebook %}
                <a href="{{ store.social.facebook }}" class="social-link">Facebook</a>
                {% endif %}
                {% if store.social.instagram %}
                <a href="{{ store.social.instagram }}" class="social-link">Instagram</a>
                {% endif %}
                {% if store.social.twitter %}
                <a href="{{ store.social.twitter }}" class="social-link">Twitter</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<nav class="header-nav">
    <div class="container">
        <div class="header-nav-inner">
            <div class="header-logo">
                <a href="{{ store.url }}">
                    {% if settings.logo %}
                    <img src="{{ settings.logo }}" alt="{{ store.name }}">
                    {% else %}
                    <span class="logo-text">{{ store.name }}</span>
                    {% endif %}
                </a>
            </div>

            <div class="header-menu">
                <ul class="nav-menu">
                    {% for item in store.menu %}
                    <li class="nav-item {% if item.children %}has-dropdown{% endif %}">
                        <a href="{{ item.url }}">{{ item.name }}</a>
                        {% if item.children %}
                        <ul class="nav-dropdown">
                            {% for child in item.children %}
                            <li><a href="{{ child.url }}">{{ child.name }}</a></li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                    </li>
                    {% endfor %}
                </ul>
            </div>

            <div class="header-actions">
                <div class="search-toggle">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                </div>

                <a href="{{ customer.profile_url }}" class="header-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </a>

                <a href="{{ customer.wishlist_url }}" class="header-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                </a>

                <a href="{{ cart.url }}" class="header-icon cart-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
                    <span class="cart-count">{{ cart.count }}</span>
                </a>
            </div>
        </div>
    </div>
</nav>
