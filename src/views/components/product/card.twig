<div class="product-card">
    <a href="{{ product.url }}" class="card-link">
        <div class="card-image">
            <img src="{{ product.image }}" alt="{{ product.name }}" loading="lazy">
            {% if product.sale_price %}
            <span class="card-badge sale">{{ trans('sale') }}</span>
            {% endif %}
        </div>
        <div class="card-body">
            {% if product.brand %}
            <span class="card-brand">{{ product.brand.name }}</span>
            {% endif %}
            <h3 class="card-title">{{ product.name }}</h3>
            <div class="card-price">
                {% if product.sale_price %}
                <span class="price-sale">{{ product.sale_price }}</span>
                <span class="price-original">{{ product.price }}</span>
                {% else %}
                <span class="price-current">{{ product.price }}</span>
                {% endif %}
            </div>
            {% if product.rating %}
            <div class="card-rating">
                <span class="stars">{{ product.rating.stars }}</span>
                <span class="rating-count">({{ product.rating.count }})</span>
            </div>
            {% endif %}
        </div>
    </a>
    <button class="btn-add-cart" data-product-id="{{ product.id }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
    </button>
</div>
