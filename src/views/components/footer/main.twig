<div class="footer-main">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-col footer-about">
                <a href="{{ store.url }}" class="footer-logo">
                    {% if settings.logo %}
                    <img src="{{ settings.logo }}" alt="{{ store.name }}">
                    {% else %}
                    <span>{{ store.name }}</span>
                    {% endif %}
                </a>
                <p class="footer-desc">{{ store.description }}</p>
                <div class="footer-social">
                    {% if store.social.facebook %}
                    <a href="{{ store.social.facebook }}" class="social-link">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
                    </a>
                    {% endif %}
                    {% if store.social.instagram %}
                    <a href="{{ store.social.instagram }}" class="social-link">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                    </a>
                    {% endif %}
                    {% if store.social.twitter %}
                    <a href="{{ store.social.twitter }}" class="social-link">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg>
                    </a>
                    {% endif %}
                </div>
            </div>

            <div class="footer-col">
                <h3 class="footer-title">{{ trans('quick_links') }}</h3>
                <ul class="footer-links">
                    {% for item in store.menu %}
                    <li><a href="{{ item.url }}">{{ item.name }}</a></li>
                    {% endfor %}
                </ul>
            </div>

            <div class="footer-col">
                <h3 class="footer-title">{{ trans('customer_service') }}</h3>
                <ul class="footer-links">
                    <li><a href="{{ store.faq_url }}">{{ trans('faq') }}</a></li>
                    <li><a href="{{ store.contact_url }}">{{ trans('contact_us') }}</a></li>
                    <li><a href="{{ store.shipping_url }}">{{ trans('shipping_policy') }}</a></li>
                    <li><a href="{{ store.return_url }}">{{ trans('return_policy') }}</a></li>
                    <li><a href="{{ store.privacy_url }}">{{ trans('privacy_policy') }}</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h3 class="footer-title">{{ trans('contact_us') }}</h3>
                <ul class="footer-contact">
                    <li>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        {{ store.address }}
                    </li>
                    <li>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
                        {{ store.phone }}
                    </li>
                    <li>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        {{ store.email }}
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="footer-bottom">
    <div class="container">
        <div class="footer-bottom-inner">
            <p>{{ trans('copyright') }} &copy; {{ "now"|date("Y") }} {{ store.name }}. {{ trans('all_rights_reserved') }}</p>
            <div class="footer-payments">
                {% for method in store.payment_methods %}
                <span class="payment-icon">{{ method.name }}</span>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
