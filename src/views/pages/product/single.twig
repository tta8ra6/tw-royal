{% extends "layouts.master" %}

{% block title %}{{ product.name }} - {{ store.name }}{% endblock %}

{% block content %}

<section class="product-single">
    <div class="container">
        {% hook 'product:start' %}

        <div class="product-layout">
            <div class="product-gallery">
                <div class="product-main-image">
                    <img src="{{ product.image }}" alt="{{ product.name }}">
                </div>
                {% if product.images %}
                <div class="product-thumbnails">
                    {% for image in product.images %}
                    <div class="thumbnail">
                        <img src="{{ image }}" alt="{{ product.name }}">
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>

            <div class="product-info">
                <h1 class="product-name">{{ product.name }}</h1>

                {% if product.brand %}
                <p class="product-brand">{{ product.brand.name }}</p>
                {% endif %}

                <div class="product-price">
                    {% if product.sale_price %}
                    <span class="price-sale">{{ product.sale_price }}</span>
                    <span class="price-original">{{ product.price }}</span>
                    {% else %}
                    <span class="price-current">{{ product.price }}</span>
                    {% endif %}
                </div>

                {% if product.rating %}
                <div class="product-rating">
                    <span class="stars">{{ product.rating.stars }}</span>
                    <span class="rating-count">({{ product.rating.count }} {{ trans('reviews') }})</span>
                </div>
                {% endif %}

                <div class="product-description">
                    {{ product.description|raw }}
                </div>

                <div class="product-actions">
                    <button class="btn btn-primary btn-add-to-cart" data-product-id="{{ product.id }}">
                        {{ trans('add_to_cart') }}
                    </button>
                </div>

                {% if product.options %}
                <div class="product-options">
                    {% for option in product.options %}
                    <div class="option-group">
                        <label>{{ option.name }}</label>
                        <select class="option-select" data-option-id="{{ option.id }}">
                            {% for value in option.values %}
                            <option value="{{ value.id }}">{{ value.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>

        {% hook 'product:end' %}
    </div>
</section>

{% endblock %}
